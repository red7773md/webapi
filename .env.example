# Copy to .env and fill in. Load with:  set -a; . ./.env; set +a
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Optional. If empty, a random key is created in data/.app_secret.
APP_SECRET_KEY=

# Set to 1 when serving over HTTPS so the session cookie is HTTPS-only.
COOKIE_SECURE=0

# Optional. Where cookies and outputs are kept. Defaults to ./data
# GEMINI_WEBUI_DATA=/var/lib/gemini-webui
